---
import { getGrade, getPowder } from "../lib/gelatin-conversion.js";

const knox = getPowder("knox");
const gold = getGrade("gold");
---
<div class="grid grid-cols-1 sm:grid-cols-2 gap-5 max-w-3xl mx-auto">
  <div class="rounded-2xl bg-white border border-stone-200 p-8 sm:p-10 text-center shadow-sm">
    <div class="text-sm uppercase tracking-widest text-stone-500 mb-3">
      Knox unflavored powder
    </div>
    <div class="font-serif text-5xl sm:text-6xl text-stone-900">~{knox.bloom}</div>
    <div class="text-stone-600 mt-2">bloom</div>
  </div>
  <div class="rounded-2xl bg-white border border-stone-200 p-8 sm:p-10 text-center shadow-sm">
    <div class="text-sm uppercase tracking-widest text-stone-500 mb-3">
      Typical French pastry recipe
    </div>
    <div class="font-serif text-5xl sm:text-6xl text-stone-900">~{gold.bloom}</div>
    <div class="text-stone-600 mt-2">bloom ({gold.name.toLowerCase()})</div>
  </div>
</div>
