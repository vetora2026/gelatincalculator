---
import "../styles/global.css";
import BaseHead from "../components/BaseHead.astro";
import Diagnostic from "../components/Diagnostic.jsx";
import TwoLegos from "../components/TwoLegos.astro";
import Footer from "../components/Footer.astro";
import {
  getGrade,
  getPowder,
  sheetGramsToPowderGrams,
  bloomFactor,
  BLOOM_EXPONENT,
  fmt1,
} from "../lib/gelatin-conversion.js";

// Title, H1 and description values come from the bloom data, never typed.
const knox = getPowder("knox");
const gold = getGrade("gold");
const silver = getGrade("silver");
const platinum = getGrade("platinum");

// Worked example used in the explainer: a recipe written for gold sheets.
const EXAMPLE_GRAMS = 6;
const exampleAsSilver = fmt1(EXAMPLE_GRAMS * bloomFactor(gold.bloom, silver.bloom));
const exampleAsKnox = fmt1(sheetGramsToPowderGrams(EXAMPLE_GRAMS, "gold", "knox"));

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "What is bloom strength?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "A standardized measurement of how firm a gelatin sets. It's the force (in grams) needed to push a small plunger a fixed depth into a chilled 6.67% gelatin solution. Higher numbers mean firmer gels.",
      },
    },
    {
      "@type": "Question",
      name: "Why doesn't my gelatin box list a bloom value?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Consumer brands rarely print it. Bloom strength is a technical spec meant for bakeries and food manufacturers. Professional sheet gelatin is an exception because the color grades (silver, gold, platinum) correspond to published bloom ranges.",
      },
    },
    {
      "@type": "Question",
      name: "What bloom strength is Knox?",
      acceptedAnswer: {
        "@type": "Answer",
        text: `Knox Unflavored Gelatin is widely reported at around ${knox.bloom} bloom. The manufacturer doesn\u2019t print this on consumer packaging, but the value is confirmed by multiple independent cooking references.`,
      },
    },
    {
      "@type": "Question",
      name: "What's the difference between sheet and powder gelatin?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Sheet and powder gelatin work the same way chemically, but they're handled differently. Sheets are bloomed in cold water, squeezed out, and stirred into warm liquid. Powder is sprinkled over cold liquid, allowed to absorb, and then warmed. Always go by weight and bloom, not by sheets or packets.",
      },
    },
    {
      "@type": "Question",
      name: "Can I use less of a stronger gelatin instead of converting?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes — that's exactly what the conversion does. If your gelatin is stronger than what the recipe calls for, the formula tells you how much less to use to hit the same firmness.",
      },
    },
    {
      "@type": "Question",
      name: "Is this calculator accurate enough for professional baking?",
      acceptedAnswer: {
        "@type": "Answer",
        text: `The site converts by the square root of the bloom ratio, which matches the one professional conversion table we could check. It is accurate enough for most home and small-batch pastry work. For texture-critical applications, always test a small batch first. The method is written out at /sheets-to-powder/#method.`,
      },
    },
  ],
};

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "Gelatin Bloom Strength Calculator",
  url: "https://gelatincalculator.com/",
  applicationCategory: "UtilityApplication",
  operatingSystem: "Any",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
  description: `Convert gelatin amounts between bloom strengths. Covers Knox (~${knox.bloom}), gold (~${gold.bloom}), silver (~${silver.bloom}), platinum (~${platinum.bloom}), and more.`,
};
const title = "Gelatin Conversion Calculator — Bloom, Sheets to Powder, Knox";
const description = `Convert gelatin amounts between bloom strengths: Knox (~${knox.bloom}), gold (~${gold.bloom}), silver (~${silver.bloom}), platinum (~${platinum.bloom}). Free diagnostic tool for home bakers.`;
---
<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={description}
      path="/"
    />
    <Fragment set:html={`<script type="application/ld+json">${JSON.stringify(faqSchema)}</script>`} />
    <Fragment set:html={`<script type="application/ld+json">${JSON.stringify(webAppSchema)}</script>`} />
  </head>
  <body class="bg-white text-stone-900">
    <nav class="border-b border-stone-200">
      <div class="max-w-5xl mx-auto px-5 py-4 flex items-center justify-between">
        <a href="/" class="font-serif text-xl text-stone-900">
          gelatincalculator.com
        </a>
        <div class="flex gap-5 text-sm text-stone-600">
          <a href="/about" class="hover:text-amber-700">About</a>
          <a href="/contact" class="hidden sm:inline hover:text-amber-700">Contact</a>
          <a href="/privacy" class="hover:text-amber-700">Privacy</a>
          <a href="/terms" class="hidden sm:inline hover:text-amber-700">Terms</a>
        </div>
      </div>
    </nav>

    <header class="max-w-5xl mx-auto px-5 pt-16 sm:pt-24 pb-12 sm:pb-20 text-center">
      <h1 class="font-serif text-4xl sm:text-5xl md:text-6xl text-stone-900 mb-10">
        Gelatin Conversion Calculator
      </h1>
      <TwoLegos />
    </header>

    <main class="max-w-5xl mx-auto px-5">
      <div class="mt-16">
        <Diagnostic client:load />
      </div>

      <div class="mt-8 max-w-3xl mx-auto flex flex-wrap gap-x-6 gap-y-2 text-sm text-stone-500">
        <a href="/what-is-gelatin-bloom-strength/" class="hover:text-amber-700 underline underline-offset-4">
          What is bloom strength?
        </a>
        <a href="/sheets-to-powder/" class="hover:text-amber-700 underline underline-offset-4">
          Converting sheets to powder instead?
        </a>
        <a href="/articles/" class="hover:text-amber-700 underline underline-offset-4">
          All reference articles
        </a>
      </div>

      <section class="mt-24 max-w-3xl mx-auto">
        <h2 class="font-serif text-3xl sm:text-4xl text-stone-900 mb-6">
          How bloom strength works
        </h2>
        <div class="prose prose-stone max-w-none text-stone-700 leading-relaxed space-y-4">
          <p>
            Bloom strength measures how firm a gel becomes. The test is narrow
            and specific: prepare a 6.67% gelatin solution in water, chill it
            for 17 hours, and measure the force in grams required to push a
            12.7 mm plunger 4 mm into the surface. The resulting number — a
            "bloom value" — is the firmness of that gel.
          </p>
          <p>
            Different gelatins have different bloom values for two reasons.
            First, raw material: pork, beef, and fish collagen all behave
            differently. Second, processing: the length of the protein chains
            after extraction determines how strong a network the gelatin forms
            when it sets. Manufacturers sort their output into grades — sheet
            gelatin is commonly sold as titanium, bronze, silver, gold, or
            platinum, each corresponding to a bloom range. Powdered gelatins
            are rarely graded as clearly on the box, but they still fall in a
            measurable range.
          </p>
          <p>
            This matters because if a recipe calls for {EXAMPLE_GRAMS} grams of
            {gold.bloom}-bloom gelatin and you substitute {EXAMPLE_GRAMS} grams of
            {silver.bloom}-bloom silver sheets, your final gel will be noticeably
            softer — you would need {exampleAsSilver} grams of the silver to land in
            the same place. Swapping gelatins one-to-one by weight only works when
            the bloom values happen to match. They usually don't.
          </p>
          <p>
            The conversion multiplies the recipe amount by (recipe bloom ÷ your
            bloom) raised to the power {BLOOM_EXPONENT} — the square root. Bloom is
            measured at one fixed concentration, and a gel's rigidity rises with
            roughly the square of concentration, so matching firmness across two
            bloom values scales the weight by the square root of the ratio rather
            than by the ratio itself. The same {EXAMPLE_GRAMS} grams of
            {gold.bloom}-bloom gelatin comes to {exampleAsKnox} grams of Knox at
            ~{knox.bloom}. If your gelatin is weaker than the recipe's target you
            need more of it; if it is stronger, less. For texture-critical work
            (clarity, mouthfeel, delicate mousses) a small test batch is still
            worth running.{" "}
            <a href="/sheets-to-powder/#method" class="text-amber-700 underline underline-offset-4 hover:text-amber-600">
              The method, and how it differs from the straight ratio most
              calculators use.
            </a>
          </p>
        </div>
      </section>

      <section class="mt-24 max-w-3xl mx-auto">
        <h2 class="font-serif text-3xl sm:text-4xl text-stone-900 mb-8">
          Frequently asked questions
        </h2>
        <div class="space-y-6">
          <div>
            <h3 class="font-serif text-xl text-stone-900 mb-2">
              What is bloom strength?
            </h3>
            <p class="text-stone-700 leading-relaxed">
              A standardized measurement of how firm a gelatin sets. It's the
              force (in grams) needed to push a small plunger a fixed depth
              into a chilled 6.67% gelatin solution. Higher numbers mean
              firmer gels.
            </p>
          </div>
          <div>
            <h3 class="font-serif text-xl text-stone-900 mb-2">
              Why doesn't my gelatin box list a bloom value?
            </h3>
            <p class="text-stone-700 leading-relaxed">
              Consumer brands rarely print it. Bloom strength is a technical
              spec meant for bakeries and food manufacturers; packaging for
              home cooks usually just says "unflavored gelatin." Professional
              sheet gelatin is an exception because the color grades (silver,
              gold, platinum) correspond to published bloom ranges.
            </p>
          </div>
          <div>
            <h3 class="font-serif text-xl text-stone-900 mb-2">
              What bloom strength is Knox?
            </h3>
            <p class="text-stone-700 leading-relaxed">
              Knox Unflavored Gelatin is widely reported at around {knox.bloom}
              bloom. The manufacturer doesn't print this on consumer packaging,
              but the value is confirmed by multiple independent cooking
              references.
            </p>
          </div>
          <div>
            <h3 class="font-serif text-xl text-stone-900 mb-2">
              What's the difference between sheet and powder gelatin?
            </h3>
            <p class="text-stone-700 leading-relaxed">
              Sheet and powder gelatin work the same way chemically, but
              they're handled differently. Sheets are bloomed (soaked) in
              cold water, squeezed out, and stirred into warm liquid; powder
              is sprinkled over cold liquid, allowed to absorb, and then
              warmed. A sheet and a gram of powder don't necessarily have
              the same bloom strength — always go by weight and bloom, not
              by "sheets" or "packets."
            </p>
          </div>
          <div>
            <h3 class="font-serif text-xl text-stone-900 mb-2">
              Can I use less of a stronger gelatin instead of converting?
            </h3>
            <p class="text-stone-700 leading-relaxed">
              Yes — that's exactly what the conversion does. If your gelatin
              is stronger than what the recipe calls for, the formula tells
              you how much less to use to hit the same firmness.
            </p>
          </div>
          <div>
            <h3 class="font-serif text-xl text-stone-900 mb-2">
              Is this calculator accurate enough for professional baking?
            </h3>
            <p class="text-stone-700 leading-relaxed">
              It is accurate enough for most home and small-batch pastry work.
              Two caveats we would rather state than bury. Bloom values for
              consumer brands are often inferred from secondary sources rather
              than published by the manufacturer — we label our confidence level
              for each value. And the conversion uses the square root of the
              bloom ratio, where many calculators use the straight ratio;{" "}
              <a href="/sheets-to-powder/#method" class="text-amber-700 underline underline-offset-4 hover:text-amber-600">
                we set out why, and where the two disagree
              </a>. For texture-critical applications, always test a small batch
              first.
            </p>
          </div>
        </div>
      </section>
      <section class="mt-24 max-w-3xl mx-auto">
        <h2 class="font-serif text-3xl sm:text-4xl text-stone-900 mb-4">
          Looking for a specific quantity?
        </h2>
        <p class="text-stone-600 mb-6">
          Sheet-to-powder conversions worked out in advance, with the figure for every grade.
        </p>
        <div class="grid sm:grid-cols-2 gap-3">
          <a href="/1-gelatin-sheet-to-powder/" class="block border border-stone-200 rounded-xl px-4 py-3 hover:border-amber-300 transition-colors">1 gelatin sheet to powder</a>
          <a href="/2-gelatin-sheets-to-powder/" class="block border border-stone-200 rounded-xl px-4 py-3 hover:border-amber-300 transition-colors">2 gelatin sheets to powder</a>
          <a href="/3-gelatin-sheets-to-powder/" class="block border border-stone-200 rounded-xl px-4 py-3 hover:border-amber-300 transition-colors">3 gelatin sheets to powder</a>
          <a href="/4-gelatin-sheets-to-powder/" class="block border border-stone-200 rounded-xl px-4 py-3 hover:border-amber-300 transition-colors">4 gelatin sheets to powder</a>
          <a href="/5-gelatin-sheets-to-powder/" class="block border border-stone-200 rounded-xl px-4 py-3 hover:border-amber-300 transition-colors">5 gelatin sheets to powder</a>
          <a href="/6-gelatin-sheets-to-powder/" class="block border border-stone-200 rounded-xl px-4 py-3 hover:border-amber-300 transition-colors">6 gelatin sheets to powder</a>
          <a href="/gelatin-grams-sheets-to-powder/" class="block border border-stone-200 rounded-xl px-4 py-3 hover:border-amber-300 transition-colors">Grams of sheet gelatin to powder</a>
          <a href="/gelatin-powder-to-sheets/" class="block border border-stone-200 rounded-xl px-4 py-3 hover:border-amber-300 transition-colors">Gelatin powder to sheets</a>
        </div>
      </section>

      <section class="mt-24 max-w-3xl mx-auto">
        <h2 class="font-serif text-3xl sm:text-4xl text-stone-900 mb-6">
          Reference articles
        </h2>
        <div class="space-y-3">
          <a href="/what-is-gelatin-bloom-strength/" class="block border border-stone-200 rounded-xl p-4 hover:border-amber-300 transition-colors">
            <p class="font-medium text-stone-900 mb-1">What Is Gelatin Bloom Strength?</p>
            <p class="text-stone-500 text-sm">How the Bloom test works, what the grade scale means, and why the numbers matter for conversions.</p>
          </a>
          <a href="/gelatin-sheets-vs-powder/" class="block border border-stone-200 rounded-xl p-4 hover:border-amber-300 transition-colors">
            <p class="font-medium text-stone-900 mb-1">Gelatin Sheets vs Powder: What's the Difference?</p>
            <p class="text-stone-500 text-sm">Format comparison: measuring method, clarity, bloom grades, and when each format works best.</p>
          </a>
          <a href="/how-much-gelatin-per-cup-of-liquid/" class="block border border-stone-200 rounded-xl p-4 hover:border-amber-300 transition-colors">
            <p class="font-medium text-stone-900 mb-1">How Much Gelatin Per Cup of Liquid?</p>
            <p class="text-stone-500 text-sm">Reference ratios by desired texture — soft set through very firm — plus variables that affect the set.</p>
          </a>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>
