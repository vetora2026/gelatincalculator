---
import "../../styles/global.css";
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import EditorialLine from "../../components/EditorialLine.astro";
import SheetsToPowderConverter from "../../components/SheetsToPowderConverter.jsx";
import {
  sheetsToPowderGrams,
  sheetGramsToPowderGrams,
  sheetMass,
  powderToSheets,
  getGrade,
  getPowder,
  bloomFactor,
  BLOOM_EXPONENT,
  PACKET_GRAMS,
  fmt1,
} from "../../lib/gelatin-conversion.js";

// Every gelatin figure below is computed from the bloom data through the
// shared module; nothing on this page is a typed result.
const gold = getGrade("gold");
const silver = getGrade("silver");
const titanium = getGrade("titanium");
const knox = getPowder("knox");
const euro = getPowder("european-powder");

const packetAsGold = fmt1(powderToSheets(PACKET_GRAMS, "grams", "knox", "gold"));
const packetAsSilver = fmt1(powderToSheets(PACKET_GRAMS, "grams", "knox", "silver"));

// Worked example 1: a recipe calling for three gold sheets, made with Knox.
const EX1_SHEETS = 3;
const ex1Mass = fmt1(sheetMass(EX1_SHEETS, "gold"));
const ex1Knox = fmt1(sheetsToPowderGrams(EX1_SHEETS, "gold", "knox"));
// How far that figure falls short of one powder packet.
const ex1ShortPct = Math.round((1 - sheetsToPowderGrams(EX1_SHEETS, "gold", "knox") / PACKET_GRAMS) * 100);
// Worked example 2: an unlabelled European recipe given in grams.
const EX2_GRAMS = 10;
const ex2Sheets = fmt1(EX2_GRAMS / gold.g);
const ex2Knox = fmt1(sheetGramsToPowderGrams(EX2_GRAMS, "gold", "knox"));

// Method block. Modernist Pantry's published table implies these two blooms
// for the grades it names, which are not the values this site publishes, so
// they live here as locals used only for that cross-check.
const MP_CHECK_GRAMS = 10;
const MP_TITANIUM_BLOOM = 125;
const MP_PLATINUM_BLOOM = 250;
const mpSqrt = fmt1(MP_CHECK_GRAMS * bloomFactor(MP_TITANIUM_BLOOM, MP_PLATINUM_BLOOM));
const mpLinear = fmt1((MP_CHECK_GRAMS * MP_TITANIUM_BLOOM) / MP_PLATINUM_BLOOM);

// How far the two methods sit apart, grade by grade, against Knox.
const divergencePct = (gradeId) => {
  const b = getGrade(gradeId).bloom;
  const linear = b / knox.bloom;
  return Math.round((Math.abs(bloomFactor(b, knox.bloom) - linear) / linear) * 100);
};
const goldDivergence = divergencePct("gold");
const silverDivergence = divergencePct("silver");
const titaniumDivergence = divergencePct("titanium");

// One array feeds both the visible FAQ and the JSON-LD.
const faqs = [
  {
    q: "How many gelatin sheets equal one Knox packet?",
    a: `One Knox packet is ${PACKET_GRAMS}g at approximately ${knox.bloom} bloom. That's roughly ${packetAsGold} gold sheets or ${packetAsSilver} silver sheets — but these are approximations. Sheet weights vary by manufacturer, so for anything texture-critical, weigh your gelatin rather than counting sheets. <a href="#method" class="text-amber-700 underline underline-offset-4 hover:text-amber-600">How these numbers are calculated.</a>`,
  },
  {
    q: "Are all gelatin sheets the same?",
    a: "No. Titanium, bronze, silver, gold, and platinum sheets each have different weights and bloom strengths. They're designed to be interchangeable sheet-for-sheet within a grade, but swapping across grades (using silver where a recipe calls for gold, for example) will change the set strength unless you adjust by weight. The converter above handles this.",
  },
  {
    q: "Can I convert gelatin to agar agar?",
    a: `They're different systems. A rough starting point is 1 teaspoon agar powder per 1 tablespoon gelatin powder, but the texture differs significantly — agar sets firmer, gels at room temperature, and doesn't melt at body temperature the way gelatin does. Treat any gelatin-to-agar conversion as an approximation that needs testing, not a formula. The <a href="/" class="text-amber-700 underline underline-offset-4">bloom calculator</a> covers gelatin only.`,
  },
];

const stripTags = (s) => s.replace(/<[^>]+>/g, "");
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: stripTags(f.a) },
  })),
};

// One gold sheet expressed as Knox powder, computed from the bloom data.
const oneGoldAsKnox = fmt1(sheetsToPowderGrams(1, "gold", "knox"));
const title = "Gelatin Sheets to Powder: Ratio, Calculator & Chart";
const description = `Convert gelatin sheets (or gelatine leaves) to powder for bronze, silver, gold, platinum and titanium. One gold sheet ≈ ${oneGoldAsKnox}g of Knox powder.`;
---

<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={description}
      path="/sheets-to-powder/"
    />
    <Fragment set:html={`<script type="application/ld+json">${JSON.stringify(faqSchema)}</script>`} />
  </head>
  <body class="bg-white text-stone-900">
    <nav class="border-b border-stone-200">
      <div class="max-w-5xl mx-auto px-5 py-4 flex items-center justify-between">
        <a href="/" class="font-serif text-xl text-stone-900">gelatincalculator.com</a>
        <div class="flex gap-5 text-sm text-stone-600">
          <a href="/about" class="hover:text-amber-700">About</a>
          <a href="/contact" class="hidden sm:inline hover:text-amber-700">Contact</a>
          <a href="/privacy" class="hover:text-amber-700">Privacy</a>
          <a href="/terms" class="hidden sm:inline hover:text-amber-700">Terms</a>
        </div>
      </div>
    </nav>

    <main class="max-w-2xl mx-auto px-5 py-16">
      <h1 class="font-serif text-5xl text-stone-900 mb-3">Gelatin Sheets to Powder Conversion</h1>
      <EditorialLine class="mb-1" />
      <p class="text-stone-500 text-sm mb-8">For home bakers working across different gelatin formats</p>

      <div class="text-stone-700 leading-relaxed space-y-10">

        <section>
          <h2 class="font-serif text-2xl text-stone-900 mb-3">The quick answer</h2>
          <p>
            For most home baking: <strong class="text-stone-900">1 Knox packet ({PACKET_GRAMS}g) ≈ {packetAsGold} gold sheets or {packetAsSilver} silver sheets</strong>.
            For precise work, use the converter below — the correct amount depends on which grade of sheet
            and which powder you have.
          </p>
        </section>

        <section>
          <SheetsToPowderConverter client:load />
        </section>

        <section>
          <h2 class="font-serif text-2xl text-stone-900 mb-3">Why the conversion isn't a single rule</h2>
          <p>
            Sheet gelatin grades are designed to be interchangeable <em>within the same grade</em> —
            3 gold sheets from one brand will behave similarly to 3 gold sheets from another. But sheets
            have two variables that affect conversion: bloom strength and weight per sheet. These are
            independent. A gold sheet is roughly {gold.g}g at {gold.bloom} bloom; a silver sheet is
            roughly {silver.g}g at {silver.bloom} bloom.
          </p>
          <p class="mt-3">
            Powder gelatin adds a third variable: different brands have different bloom values. Knox is
            approximately {knox.bloom} bloom; European pastry powders are often closer to {euro.bloom}.
          </p>
          <p class="mt-3">
            This is why a flat "1 packet equals N sheets" is an approximation for a specific pair of
            products, not a universal rule. The converter above accounts for all three variables, and{" "}
            <a href="/sheets-to-powder/#method" class="text-amber-700 underline underline-offset-4 hover:text-amber-600">
              the arithmetic it uses is written out below
            </a>.
          </p>
          <p class="mt-3">
            Not sure what bloom strength means?{" "}
            <a href="/what-is-gelatin-bloom-strength/" class="text-amber-700 underline underline-offset-4 hover:text-amber-600">
              Read the plain-English explanation.
            </a>
          </p>
        </section>

        <section>
          <h2 class="font-serif text-2xl text-stone-900 mb-5">Common conversion scenarios</h2>
          <div class="space-y-4">
            <div class="border border-stone-200 rounded-xl p-4">
              <p class="font-medium text-stone-900 mb-2">
                "Recipe says {EX1_SHEETS} gold sheets — I only have Knox powder"
              </p>
              <p class="text-stone-600 text-sm leading-relaxed">
                {EX1_SHEETS} gold sheets = {EX1_SHEETS} × {gold.g}g = {ex1Mass}g of {gold.bloom}-bloom
                gelatin. Knox is ~{knox.bloom} bloom, so you need
                <strong class="text-stone-800"> {ex1Knox}g Knox</strong>. That is about
                {ex1ShortPct}% short of one packet. Weigh it; don't eyeball a packet and call it close enough.
              </p>
            </div>
            <div class="border border-stone-200 rounded-xl p-4">
              <p class="font-medium text-stone-900 mb-2">
                "Recipe says 1 Knox packet — I only have silver sheets"
              </p>
              <p class="text-stone-600 text-sm leading-relaxed">
                1 Knox packet = {PACKET_GRAMS}g at ~{knox.bloom} bloom. Silver sheets are ~{silver.bloom}
                bloom at ~{silver.g}g/sheet. You need
                <strong class="text-stone-800"> ≈ {packetAsSilver} silver sheets</strong>. Round to
                {Math.round(powderToSheets(PACKET_GRAMS, "grams", "knox", "silver"))}.
              </p>
            </div>
            <div class="border border-stone-200 rounded-xl p-4">
              <p class="font-medium text-stone-900 mb-2">
                "European recipe says {EX2_GRAMS}g gelatin, no type specified"
              </p>
              <p class="text-stone-600 text-sm leading-relaxed">
                European recipes that list grams without a grade typically mean gold sheets (the most
                common in European professional kitchens). Assume {gold.bloom} bloom and {gold.g}g/sheet,
                giving you {EX2_GRAMS}g = {ex2Sheets} gold sheets. If you're using Knox (~{knox.bloom}),
                use <strong class="text-stone-800">{ex2Knox}g Knox</strong>.
              </p>
            </div>
          </div>
        </section>

        <section>
          <h2 class="font-serif text-2xl text-stone-900 mb-4">Related articles</h2>
          <div class="space-y-3 mb-10">
            <a href="/gelatin-sheets-vs-powder/" class="block border border-stone-200 rounded-xl p-4 hover:border-amber-300 transition-colors">
              <p class="font-medium text-stone-900 mb-1">Gelatin Sheets vs Powder: What's the Difference?</p>
              <p class="text-stone-500 text-sm">Format comparison: measuring method, clarity, bloom grades, and when each works best.</p>
            </a>
            <a href="/what-is-gelatin-bloom-strength/" class="block border border-stone-200 rounded-xl p-4 hover:border-amber-300 transition-colors">
              <p class="font-medium text-stone-900 mb-1">What Is Gelatin Bloom Strength?</p>
              <p class="text-stone-500 text-sm">How the Bloom test works, what the grade scale means, and why it matters for substitutions.</p>
            </a>
            <a href="/how-much-gelatin-per-cup-of-liquid/" class="block border border-stone-200 rounded-xl p-4 hover:border-amber-300 transition-colors">
              <p class="font-medium text-stone-900 mb-1">How Much Gelatin Per Cup of Liquid?</p>
              <p class="text-stone-500 text-sm">Reference ratios by desired texture, plus variables that affect the set.</p>
            </a>
          </div>
        </section>

        <section>
          <h2 class="font-serif text-2xl text-stone-900 mb-4">
          Looking for a specific quantity?
        </h2>
        <p class="text-stone-600 mb-6">
          Sheet-to-powder conversions worked out in advance, with the figure for every grade.
        </p>
        <div class="grid sm:grid-cols-2 gap-3">
          <a href="/1-gelatin-sheet-to-powder/" class="block border border-stone-200 rounded-xl px-4 py-3 hover:border-amber-300 transition-colors">1 gelatin sheet to powder</a>
          <a href="/2-gelatin-sheets-to-powder/" class="block border border-stone-200 rounded-xl px-4 py-3 hover:border-amber-300 transition-colors">2 gelatin sheets to powder</a>
          <a href="/3-gelatin-sheets-to-powder/" class="block border border-stone-200 rounded-xl px-4 py-3 hover:border-amber-300 transition-colors">3 gelatin sheets to powder</a>
          <a href="/4-gelatin-sheets-to-powder/" class="block border border-stone-200 rounded-xl px-4 py-3 hover:border-amber-300 transition-colors">4 gelatin sheets to powder</a>
          <a href="/5-gelatin-sheets-to-powder/" class="block border border-stone-200 rounded-xl px-4 py-3 hover:border-amber-300 transition-colors">5 gelatin sheets to powder</a>
          <a href="/6-gelatin-sheets-to-powder/" class="block border border-stone-200 rounded-xl px-4 py-3 hover:border-amber-300 transition-colors">6 gelatin sheets to powder</a>
          <a href="/gelatin-grams-sheets-to-powder/" class="block border border-stone-200 rounded-xl px-4 py-3 hover:border-amber-300 transition-colors">Grams of sheet gelatin to powder</a>
          <a href="/gelatin-powder-to-sheets/" class="block border border-stone-200 rounded-xl px-4 py-3 hover:border-amber-300 transition-colors">Gelatin powder to sheets</a>
        </div>
        </section>

        <section>
          <h2 class="font-serif text-2xl text-stone-900 mb-7">Frequently asked questions</h2>
          <div class="space-y-7">
            {faqs.map((f) => (
              <div>
                <h3 class="font-serif text-lg text-stone-900 mb-2">{f.q}</h3>
                <p class="text-stone-600 leading-relaxed" set:html={f.a} />
              </div>
            ))}
          </div>
        </section>


        <section id="method" class="scroll-mt-8">
          <h2 class="font-serif text-2xl text-stone-900 mb-4">How the conversion is calculated</h2>

          <p>
            Converting a sheet weight into a powder weight means answering one question: how much
            of the powder gels as hard as that much of the sheet stock? The calculation on this
            site is
          </p>
          <p class="mt-3 rounded-xl border border-stone-200 bg-stone-50 px-4 py-3 font-mono text-sm text-stone-800">
            powder grams = sheet grams × (sheet bloom ÷ powder bloom)<sup>{BLOOM_EXPONENT}</sup>
          </p>
          <p class="mt-3">
            In words: take the weight of sheet gelatin the recipe calls for, divide the sheet's bloom
            by your powder's bloom, raise that to the power {BLOOM_EXPONENT} — the square root — and
            multiply. Going the other way, from powder to sheets, the same factor is applied in
            reverse and then divided by the weight of one sheet.
          </p>

          <h3 class="font-serif text-lg text-stone-900 mt-8 mb-2">Why the square root</h3>
          <p>
            Bloom is not a measure of how much gelatin is in your bowl. It is a rigidity reading
            taken at one fixed concentration — 6.67% gelatin in water — so it describes the stock,
            not the recipe. Within a gelled network, rigidity rises with roughly the <em>square</em>
            of concentration: put twice as much gelatin in the same liquid and the gel is far more
            than twice as stiff. Matching gel strength across two bloom values therefore scales the
            weight by the square root of the bloom ratio, not by the ratio itself.
          </p>

          <h3 class="font-serif text-lg text-stone-900 mt-8 mb-2">The check</h3>
          <p>
            Modernist Pantry publishes a conversion table that gives {MP_CHECK_GRAMS}g of titanium
            sheet as ≈ 7.1g of platinum. Their table implies {MP_TITANIUM_BLOOM} bloom for titanium
            and {MP_PLATINUM_BLOOM} for platinum — not the values published elsewhere on this site,
            so those two numbers are used here for this cross-check only. On those blooms, this
            formula gives <strong class="text-stone-900">{mpSqrt}g</strong>. A straight bloom ratio
            would give <strong class="text-stone-900">{mpLinear}g</strong>.
          </p>

          <h3 class="font-serif text-lg text-stone-900 mt-8 mb-2">The alternative, plainly</h3>
          <p>
            Many online calculators use the straight ratio — sheet bloom divided by powder bloom,
            with no square root. For the grades most home cooks actually hold, the two methods land
            close together: converting gold sheets to Knox powder they differ by about
            {goldDivergence}%, and silver by about {silverDivergence}%. At the soft end of the range
            the gap is real — titanium sheets to Knox differ by about {titaniumDivergence}%. If you
            have compared this site's figure against another calculator and found a discrepancy,
            this is almost certainly where it comes from.
          </p>

          <h3 class="font-serif text-lg text-stone-900 mt-8 mb-2">One more thing about counts</h3>
          <p>
            Sheet manufacturers size their grades so that one sheet ≈ one sheet across grades — a
            titanium sheet is cut heavier precisely because titanium stock gels softer. This site
            converts by weight, which is why the titanium and bronze counts here differ from the
            count-for-count convention. Both are defensible; the weight-based figure is the one that
            holds up when you weigh what you actually put in the bowl.
          </p>
        </section>

      </div>
    </main>

    <Footer />
  </body>
</html>
