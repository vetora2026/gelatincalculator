---
import "../../styles/global.css";
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import {
  getGrade,
  getPowder,
  sheetMass,
  sheetGramsToPowderGrams,
  powderToSheets,
  bloomFactor,
  TSP_GRAMS,
  fmt1,
} from "../../lib/gelatin-conversion.js";

// No gelatin figure on this page is typed; every one is computed from the
// bloom data through the shared conversion module.
const silver = getGrade("silver");
const gold = getGrade("gold");
const bronze = getGrade("bronze");
const platinum = getGrade("platinum");
const knox = getPowder("knox");
const euro = getPowder("european-powder");

const bloomRange = (g) => `${g.range[0]}–${g.range[1]}`;
const TBSP_GRAMS = TSP_GRAMS * 3;
const tbspAsGold = fmt1(powderToSheets(TBSP_GRAMS, "grams", "knox", "gold"));
const tbspAsSilver = fmt1(powderToSheets(TBSP_GRAMS, "grams", "knox", "silver"));

// Worked example: a recipe written for gold sheets, cooked with Knox powder.
const EXAMPLE_GRAMS = 6;
const exampleAsKnox = fmt1(sheetGramsToPowderGrams(EXAMPLE_GRAMS, "gold", "knox"));
// Extra weight of silver needed to match a given weight of gold.
const silverPenaltyPct = Math.round((bloomFactor(gold.bloom, silver.bloom) - 1) * 100);

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: "Gelatin Sheets vs Powder: What's the Difference?",
  description:
    "Gelatin sheets and powder differ in bloom strength, measuring method, and clarity. Here's how they compare and when each format works best.",
  url: "https://gelatincalculator.com/gelatin-sheets-vs-powder/",
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Are gelatin sheets stronger than powder?",
      acceptedAnswer: {
        "@type": "Answer",
        text: `It depends on the grade. Silver sheets (${silver.bloom} bloom) are weaker than Knox powder (~${knox.bloom} bloom). Gold sheets (~${gold.bloom} bloom) are also weaker than Knox. Platinum sheets (~${platinum.bloom} bloom) are stronger than Knox. The grade determines strength, not the format itself.`,
      },
    },
    {
      "@type": "Question",
      name: "How many gelatin sheets equal one tablespoon of gelatin powder?",
      acceptedAnswer: {
        "@type": "Answer",
        text: `One tablespoon of gelatin powder is approximately ${fmt1(TBSP_GRAMS)}g. At Knox strength (~${knox.bloom} bloom), that is roughly equivalent to ${tbspAsGold} gold sheets or ${tbspAsSilver} silver sheets — but the precise number depends on the bloom strength of both the sheet and the powder. Weight-based conversion is more reliable than counting sheets.`,
      },
    },
    {
      "@type": "Question",
      name: "Why do professional recipes use sheets instead of powder?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Sheet gelatin produces a clearer result with fewer impurities than powder. It's also easier to measure precisely when using standard-weight sheets. European professional kitchens adopted sheets as the standard format, which is why translated pastry recipes often specify them.",
      },
    },
    {
      "@type": "Question",
      name: "Can I substitute sheets for powder in any recipe?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes, but not one-for-one by weight. You need to account for the bloom strength of both the sheet grade and the powder. A sheets-to-powder converter handles this calculation automatically.",
      },
    },
  ],
};
---

<html lang="en">
  <head>
    <BaseHead
      title="Gelatin Sheets vs Powder (Leaf Gelatine): Key Differences"
      description="Gelatin sheets and powder differ in bloom strength, measuring method, and clarity. Here's how they compare and when each format works best."
      path="/gelatin-sheets-vs-powder/"
    />
    <Fragment set:html={`<script type="application/ld+json">${JSON.stringify(articleSchema)}</script>`} />
    <Fragment set:html={`<script type="application/ld+json">${JSON.stringify(faqSchema)}</script>`} />
  </head>
  <body class="bg-white text-stone-900">
    <nav class="border-b border-stone-200">
      <div class="max-w-5xl mx-auto px-5 py-4 flex items-center justify-between">
        <a href="/" class="font-serif text-xl text-stone-900">gelatincalculator.com</a>
        <div class="flex gap-5 text-sm text-stone-600">
          <a href="/about" class="hover:text-amber-700">About</a>
          <a href="/contact" class="hidden sm:inline hover:text-amber-700">Contact</a>
          <a href="/privacy" class="hover:text-amber-700">Privacy</a>
          <a href="/terms" class="hidden sm:inline hover:text-amber-700">Terms</a>
        </div>
      </div>
    </nav>

    <main class="max-w-2xl mx-auto px-5 py-16">
      <h1 class="font-serif text-5xl text-stone-900 mb-3">Gelatin Sheets vs Powder</h1>
      <p class="text-stone-500 text-sm mb-12">A format comparison for home bakers and cooks</p>

      <div class="text-stone-700 leading-relaxed space-y-12">

        <section>
          <div class="grid grid-cols-2 gap-4 mb-6">
            <div class="border border-stone-200 rounded-xl p-5">
              <p class="text-xs text-stone-500 uppercase tracking-wide mb-2">One silver sheet</p>
              <p class="font-serif text-3xl text-stone-900 mb-1">{fmt1(sheetMass(1, "silver"))} g</p>
              <p class="text-sm text-stone-600">of gelatin at {silver.bloom} bloom</p>
            </div>
            <div class="border border-stone-200 rounded-xl p-5">
              <p class="text-xs text-stone-500 uppercase tracking-wide mb-2">One teaspoon powder</p>
              <p class="font-serif text-3xl text-stone-900 mb-1">{TSP_GRAMS} g</p>
              <p class="text-sm text-stone-600">of gelatin at ~{knox.bloom} bloom (Knox)</p>
            </div>
          </div>
          <p class="text-sm text-stone-500">
            Same ingredient, different formats. The numbers above illustrate why
            "1 sheet equals 1 teaspoon" is not a reliable rule. Sheet gelatin is
            sold as leaf gelatine in the UK, so a British recipe asking for
            gelatine leaves means the sheets described here.
          </p>
        </section>

        <section>
          <h2 class="font-serif text-2xl text-stone-900 mb-4">Side-by-side comparison</h2>
          <div class="overflow-x-auto -mx-1">
            <table class="w-full text-sm border-collapse">
              <thead>
                <tr class="border-b border-stone-200 text-left text-stone-500">
                  <th class="py-2 px-2 font-medium">Property</th>
                  <th class="py-2 px-2 font-medium">Gelatin Sheets</th>
                  <th class="py-2 px-2 font-medium">Gelatin Powder</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-stone-100 text-stone-700">
                <tr>
                  <td class="py-2.5 px-2 font-medium text-stone-900">Measured by</td>
                  <td class="py-2.5 px-2">Count (sheets)</td>
                  <td class="py-2.5 px-2">Weight (tsp / tbsp / grams)</td>
                </tr>
                <tr>
                  <td class="py-2.5 px-2 font-medium text-stone-900">Bloom grades</td>
                  <td class="py-2.5 px-2">Bronze ({bloomRange(bronze)}), Silver ({bloomRange(silver)}), Gold ({bloomRange(gold)}), Platinum ({bloomRange(platinum)})</td>
                  <td class="py-2.5 px-2">Typically {euro.bloom}–{knox.bloom} bloom (Knox ~{knox.bloom})</td>
                </tr>
                <tr>
                  <td class="py-2.5 px-2 font-medium text-stone-900">Dissolving method</td>
                  <td class="py-2.5 px-2">Soak in cold water 5–10 min, squeeze out, stir into warm liquid</td>
                  <td class="py-2.5 px-2">Sprinkle over cold liquid to bloom, then heat</td>
                </tr>
                <tr>
                  <td class="py-2.5 px-2 font-medium text-stone-900">Clarity in final dish</td>
                  <td class="py-2.5 px-2">Higher — fewer impurities</td>
                  <td class="py-2.5 px-2">Slightly cloudier</td>
                </tr>
                <tr>
                  <td class="py-2.5 px-2 font-medium text-stone-900">Common in</td>
                  <td class="py-2.5 px-2">European recipes, professional pastry</td>
                  <td class="py-2.5 px-2">American recipes, home cooking</td>
                </tr>
                <tr>
                  <td class="py-2.5 px-2 font-medium text-stone-900">Flavor</td>
                  <td class="py-2.5 px-2">Nearly neutral</td>
                  <td class="py-2.5 px-2">Faint gelatin taste possible</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>

        <section>
          <h2 class="font-serif text-2xl text-stone-900 mb-3">When recipes cross formats</h2>
          <p>
            European pastry recipes — cookbooks from France, Italy, and Scandinavia, or
            translations of professional manuals — almost always specify sheets by count
            and implicitly assume a grade (usually gold or silver). American recipes,
            and most home-cooking sources, call for packets or teaspoons of powder.
          </p>
          <p class="mt-3">
            The problem arises when you cross formats without accounting for bloom strength.
            Sheet grades are named: bronze ({bloomRange(bronze)} bloom), silver (~{silver.bloom}),
            gold ({bloomRange(gold)}), platinum ({bloomRange(platinum)}). Each grade has a standard
            weight per sheet as well as a different bloom value. A recipe asking for a bare sheet
            count without naming a grade is ambiguous — the same count of bronze and of platinum
            are very different quantities ({fmt1(sheetMass(3, "bronze"))}g against
            {fmt1(sheetMass(3, "platinum"))}g for three of each).
          </p>
          <p class="mt-3">
            Powder adds its own variable: Knox is approximately {knox.bloom} bloom, but European
            pastry powders often run closer to {euro.bloom}. If a converted recipe says "use X grams
            of powder," it typically assumes {euro.bloom}-bloom European powder, not
            {knox.bloom}-bloom Knox. Using Knox at the same weight will produce a firmer result
            than intended.
          </p>
          <p class="mt-3">
            For precise conversions between any sheet grade and any powder, the{" "}
            <a href="/sheets-to-powder/" class="text-amber-700 underline underline-offset-4 hover:text-amber-600">
              sheets-to-powder converter
            </a>{" "}
            accounts for all three variables: sheet weight, sheet bloom, and powder bloom.
          </p>
        </section>

        <section>
          <h2 class="font-serif text-2xl text-stone-900 mb-4">The bloom factor</h2>
          <div class="grid grid-cols-2 gap-4 mb-5">
            <div class="border border-stone-200 rounded-xl p-5">
              <p class="text-xs text-stone-500 uppercase tracking-wide mb-2">Gold sheet at {gold.bloom} bloom</p>
              <p class="font-serif text-2xl text-stone-900 mb-1">~{silverPenaltyPct}% less</p>
              <p class="text-sm text-stone-600">weight needed than silver ({silver.bloom} bloom) for the same set</p>
            </div>
            <div class="border border-stone-200 rounded-xl p-5">
              <p class="text-xs text-stone-500 uppercase tracking-wide mb-2">Knox powder</p>
              <p class="font-serif text-2xl text-stone-900 mb-1">~{knox.bloom} bloom</p>
              <p class="text-sm text-stone-600">stronger per gram than gold or silver sheets</p>
            </div>
          </div>
          <p>
            A gram of {gold.bloom}-bloom gelatin gels harder than a gram of {silver.bloom}-bloom
            gelatin, so matching a set across grades means adjusting the weight: you need about
            {silverPenaltyPct}% more silver by weight than gold. Weight and bloom together are the
            only reliable way to compare across formats.
          </p>
          <p class="mt-3">
            The formula: multiply the recipe quantity by the square root of
            (recipe bloom ÷ your bloom). If a recipe calls for {EXAMPLE_GRAMS}g of
            {gold.bloom}-bloom gold gelatin and you have Knox (~{knox.bloom} bloom), you need
            {exampleAsKnox}g of Knox — a small but measurable difference.{" "}
            <a href="/sheets-to-powder/#method" class="text-amber-700 underline underline-offset-4 hover:text-amber-600">
              Why the square root, and where the straight ratio disagrees.
            </a>
          </p>
          <div class="mt-5 p-4 bg-amber-50 border border-amber-200 rounded-xl">
            <p class="text-sm text-amber-900">
              <a href="/sheets-to-powder/" class="underline underline-offset-4 font-medium hover:text-amber-700">
                Convert between sheets and powder →
              </a>{" "}
              Enter your sheet grade and target powder to get exact gram equivalents.
            </p>
          </div>
        </section>

        <section>
          <h2 class="font-serif text-2xl text-stone-900 mb-7">Frequently asked questions</h2>
          <div class="space-y-7">
            <div>
              <h3 class="font-serif text-lg text-stone-900 mb-2">Are gelatin sheets stronger than powder?</h3>
              <p class="text-stone-600 leading-relaxed">
                It depends on the grade. Silver sheets ({silver.bloom} bloom) are weaker per gram than
                Knox powder (~{knox.bloom} bloom). Gold sheets (~{gold.bloom} bloom) are also weaker
                than Knox. Platinum (~{platinum.bloom} bloom) is stronger. The format — sheet vs.
                powder — doesn't determine strength. The bloom value does.
              </p>
            </div>
            <div>
              <h3 class="font-serif text-lg text-stone-900 mb-2">How many sheets equal one tablespoon of gelatin powder?</h3>
              <p class="text-stone-600 leading-relaxed">
                One tablespoon of gelatin powder is approximately {fmt1(TBSP_GRAMS)}g. At Knox strength
                (~{knox.bloom} bloom), that's roughly {tbspAsGold} gold sheets or {tbspAsSilver} silver
                sheets — but these are approximations that depend on the specific bloom of both the
                sheet and the powder. Use weight-based math rather than sheet counts for precise work.
              </p>
            </div>
            <div>
              <h3 class="font-serif text-lg text-stone-900 mb-2">Why do professional recipes use sheets instead of powder?</h3>
              <p class="text-stone-600 leading-relaxed">
                Sheet gelatin produces a clearer result with fewer impurities, which matters for
                mirror glazes, aspics, and transparent preparations where visual clarity is part of
                the recipe goal. Sheets also make it easier to measure a consistent quantity when
                using the standard-weight sheets from a known supplier. European professional
                kitchens standardized on sheets, so translated books carry that format forward.
              </p>
            </div>
            <div>
              <h3 class="font-serif text-lg text-stone-900 mb-2">Can I substitute sheets for powder in any recipe?</h3>
              <p class="text-stone-600 leading-relaxed">
                Yes. The formats are chemically the same — both are hydrolyzed collagen.
                What changes is the amount needed to hit the same firmness, since the bloom
                values usually differ. The{" "}
                <a href="/sheets-to-powder/" class="text-amber-700 underline underline-offset-4">
                  sheets converter
                </a>{" "}
                handles the math, and{" "}
                <a href="/sheets-to-powder/#method" class="text-amber-700 underline underline-offset-4">
                  the method is written out
                </a>{" "}
                if you want to check it.
              </p>
            </div>
          </div>
        </section>

        <section>
          <h2 class="font-serif text-2xl text-stone-900 mb-4">
          Looking for a specific quantity?
        </h2>
        <p class="text-stone-600 mb-6">
          Sheet-to-powder conversions worked out in advance, with the figure for every grade.
        </p>
        <div class="grid sm:grid-cols-2 gap-3">
          <a href="/1-gelatin-sheet-to-powder/" class="block border border-stone-200 rounded-xl px-4 py-3 hover:border-amber-300 transition-colors">1 gelatin sheet to powder</a>
          <a href="/2-gelatin-sheets-to-powder/" class="block border border-stone-200 rounded-xl px-4 py-3 hover:border-amber-300 transition-colors">2 gelatin sheets to powder</a>
          <a href="/3-gelatin-sheets-to-powder/" class="block border border-stone-200 rounded-xl px-4 py-3 hover:border-amber-300 transition-colors">3 gelatin sheets to powder</a>
          <a href="/4-gelatin-sheets-to-powder/" class="block border border-stone-200 rounded-xl px-4 py-3 hover:border-amber-300 transition-colors">4 gelatin sheets to powder</a>
          <a href="/5-gelatin-sheets-to-powder/" class="block border border-stone-200 rounded-xl px-4 py-3 hover:border-amber-300 transition-colors">5 gelatin sheets to powder</a>
          <a href="/6-gelatin-sheets-to-powder/" class="block border border-stone-200 rounded-xl px-4 py-3 hover:border-amber-300 transition-colors">6 gelatin sheets to powder</a>
          <a href="/gelatin-grams-sheets-to-powder/" class="block border border-stone-200 rounded-xl px-4 py-3 hover:border-amber-300 transition-colors">Grams of sheet gelatin to powder</a>
          <a href="/gelatin-powder-to-sheets/" class="block border border-stone-200 rounded-xl px-4 py-3 hover:border-amber-300 transition-colors">Gelatin powder to sheets</a>
        </div>
        </section>

        <section>
          <h2 class="font-serif text-2xl text-stone-900 mb-4">Related articles</h2>
          <div class="space-y-3">
            <a href="/what-is-gelatin-bloom-strength/" class="block border border-stone-200 rounded-xl p-4 hover:border-amber-300 transition-colors">
              <p class="font-medium text-stone-900 mb-1">What Is Gelatin Bloom Strength?</p>
              <p class="text-stone-500 text-sm">How the bloom test works, what the grade scale means, and why it matters for recipe conversions.</p>
            </a>
            <a href="/how-much-gelatin-per-cup-of-liquid/" class="block border border-stone-200 rounded-xl p-4 hover:border-amber-300 transition-colors">
              <p class="font-medium text-stone-900 mb-1">How Much Gelatin Per Cup of Liquid?</p>
              <p class="text-stone-500 text-sm">Reference ratios by desired texture, plus variables that affect the set.</p>
            </a>
          </div>
        </section>

      </div>
    </main>

    <Footer />
  </body>
</html>
