# Cloudflare Pages headers configuration
# Docs: https://developers.cloudflare.com/pages/configuration/headers/
#
# IMPORTANT: this is NOT first-match-wins. "An incoming request which matches
# multiple rules' URL patterns will inherit all rules' headers." So the /*
# catch-all below also matches /_astro/*, /favicon.ico and every image, and its
# Cache-Control merges into theirs. Anywhere the catch-all must not apply, the
# header is detached first with "! Cache-Control" and then set again.
# Detach rules must come AFTER the more pervasive rule they undo.

# --- HTML pages (the catch-all) --------------------------------------------
# Cache at the edge for an hour, serve stale while revalidating.
/*
  Cache-Control: public, max-age=3600, s-maxage=3600, stale-while-revalidate=86400

# --- Hashed build assets ----------------------------------------------------
# Filenames contain a content hash, so these are safe to cache for a year.
# The detach is what stops the /* rule above from capping max-age.
/_astro/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# --- Static images, fonts, icons -------------------------------------------
/*.svg
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/*.png
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/*.jpg
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/*.jpeg
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/*.webp
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/*.woff2
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/*.woff
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# --- Favicon — moderate cache, can change occasionally ----------------------
/favicon.ico
  ! Cache-Control
  Cache-Control: public, max-age=86400

# --- Robots.txt and sitemap — short cache, may update with content ----------
/robots.txt
  ! Cache-Control
  Cache-Control: public, max-age=3600
/sitemap*.xml
  ! Cache-Control
  Cache-Control: public, max-age=3600
